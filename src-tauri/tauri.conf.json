{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "txtx-app",
  "version": "0.1.0",
  "identifier": "com.administrator.txtx-app",
  "build": {
    "beforeDevCommand": "pnpm dev:frontend:tauri",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "txtx 小说下载器",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
