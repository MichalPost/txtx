{
  "name": "txtx-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c cyan,magenta --kill-others-on-fail \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "dev:frontend": "vite",
    "dev:backend": "cross-env HTTP_PROXY= HTTPS_PROXY= http_proxy= https_proxy= cargo run --bin txtx-server --manifest-path src-tauri/Cargo.toml",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.0",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "2.5.4",
    "animejs": "^4.4.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.21",
    "framer-motion": "^12.40.0",
    "fuse.js": "^7.4.1",
    "idb-keyval": "^6.2.4",
    "lucide-react": "1.17.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.77.0",
    "react-router-dom": "7.16.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwindcss": "4.3.0",
    "zod": "^4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.8.10",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tauri-apps/cli": "2.11.2",
    "@types/node": "^25.9.1",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "10.0.1",
    "cross-env": "10.1.0",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  }
}
